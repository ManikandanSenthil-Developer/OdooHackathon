// Attendance schema fragment for integration with the Dayflow HRMS schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALFDAY
  LEAVE
}

model Attendance {
  id           Int              @id @default(autoincrement())
  employeeId   String
  date         DateTime
  checkIn      DateTime?
  checkOut     DateTime?
  status       AttendanceStatus @default(PRESENT)
  workingHours Float            @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // The User relation is added when this schema is merged with the auth schema.
  @@unique([employeeId, date])
}
